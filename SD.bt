typedef struct SubScriptDef
{
      
        char name[28] <bgcolor=0x55ffaa>;
           
        uint startPos <bgcolor=0xffaa55>;
            
        if (startPos < FileSize())
        {
            local int returnP = FTell();
            FSeek(startPos);
            byte startingByte <bgcolor=0x00ffff>;
            FSeek(returnP);
        }
       
};

struct SDHeaderStruct
{
    char Identifier[8] <bgcolor=0xffaaff>;
    
    int FileSize <bgcolor=0xffffaa>;
    
    short Version;
    
    short Unknown <bgcolor=0xff44aa>;
    
    int padding[6];
    
    uint funcsPointer <bgcolor=0xffaaaa>;
    uint entryPointer <bgcolor=0xaaaaff>;
    
} SDHeader <bgcolor=0xaaaaaa>;

FSeek(SDHeader.entryPointer);
byte startingOpcode <bgcolor=0x1111ff>;

FSeek(SDHeader.funcsPointer);

int numFuncs <bgcolor=0xffaaaa>;

uint funcArrayPointer;
FSeek(funcArrayPointer);

SubScriptDef subScripts[numFuncs] <optimize=false>;